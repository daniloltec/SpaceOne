# Copie para .env e troque os segredos antes de qualquer deploy.
# O Compose lê este arquivo. Dentro dos containers, DATABASE_URL aponta para o serviço db.

POSTGRES_USER=spaceone
POSTGRES_PASSWORD=spaceone
POSTGRES_DB=spaceone
POSTGRES_PORT=5433
APP_PORT=3000

DATABASE_URL=postgresql://spaceone:spaceone@localhost:5433/spaceone
AUTH_SECRET=troque-por-um-segredo-longo
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=altere-esta-senha
TZ=America/Fortaleza
UPLOAD_DIR=./data/uploads

# Vazios: a reserva é gravada e a sincronização espera a configuração.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE_USER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
